build/
DerivedData/
*.xcuserdatad
xcuserdata/
*.xcworkspace/xcuserdata/

# Generated by `xcodegen generate` from project.yml.
*.xcodeproj

# LLVM coverage counters, dumped by an instrumented binary when it exits, into
# whatever its working directory happens to be. This app is run straight from
# the terminal so stdout stays attached, which means that directory is usually
# the repo root. A zero-byte one used to be committed here, so every run left
# the tree dirty.
*.profraw
*.profdata
